---
const { title, technique, measure, year, price, image } = Astro.props;
---

<div class="group bg-blanco rounded-sm overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 border border-mensajero/20 flex flex-col">

  <div class="relative overflow-hidden h-64 sm:h-80 bg-mensajero/10">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
    />
    <div class="absolute inset-0 bg-argos/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <div class="p-6 flex flex-col flex-grow justify-between relative">
    <div class="absolute left-0 top-6 bottom-6 w-1 bg-basenji transform scale-y-0 group-hover:scale-y-100 transition-transform duration-500 origin-top"></div>

    <div>
      <h3 class="text-2xl font-serif font-bold text-argos mb-1 group-hover:text-basenji transition-colors">{title}</h3>
      <p class="text-xs text-mensajero font-bold uppercase tracking-widest mb-4">{year} — {technique}</p>

      <div class="space-y-1 text-sm text-argos/80 border-t border-mensajero/20 pt-3 mt-2">
        <p><span class="font-bold">Medidas:</span> {measure}</p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <span class="text-xl font-bold text-argos">{price}</span>
      <a href={`https://wa.me/522228762812?text=Hola, me interesa la obra "${title}"`} target="_blank" class="text-basenji font-bold text-sm uppercase border-b-2 border-transparent hover:border-basenji transition-all pb-0.5">
        Solicitar →
      </a>
    </div>
  </div>
</div>