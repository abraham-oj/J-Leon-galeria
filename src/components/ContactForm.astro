<section id="contacto" class="py-24 bg-glucosa">
  <div class="max-w-4xl mx-auto px-6">

    <div class="bg-white p-10 md:p-16 shadow-2xl border-t-8 border-basenji relative">
      <div class="absolute top-4 right-4 w-full h-full border-2 border-argos/10 -z-10 transform translate-x-4 translate-y-4"></div>

      <div class="text-center mb-12">
        <h2 class="text-4xl font-serif font-bold text-argos mb-2">Hablemos de Arte</h2>
        <p class="text-mensajero text-sm uppercase tracking-widest">Comisiones • Adquisiciones • Colaboraciones</p>
      </div>

      <form class="space-y-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <label class="text-xs font-bold uppercase tracking-widest text-argos">Nombre Completo</label>
            <input type="text" class="w-full border-b border-mensajero py-2 focus:border-basenji focus:outline-none transition-colors bg-transparent" placeholder="Tu nombre">
          </div>
          <div class="space-y-2">
            <label class="text-xs font-bold uppercase tracking-widest text-argos">Correo Electrónico</label>
            <input type="email" class="w-full border-b border-mensajero py-2 focus:border-basenji focus:outline-none transition-colors bg-transparent" placeholder="tucorreo@email.com">
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-xs font-bold uppercase tracking-widest text-argos">Mensaje o Interés</label>
          <textarea rows="4" class="w-full border-b border-mensajero py-2 focus:border-basenji focus:outline-none transition-colors bg-transparent resize-none" placeholder="¿Qué obra ha capturado tu atención?"></textarea>
        </div>

        <div class="text-center pt-6">
          <button type="submit" class="bg-argos text-white px-12 py-4 font-bold uppercase tracking-widest hover:bg-basenji transition-all shadow-lg">
            Enviar Mensaje
          </button>
        </div>
      </form>

    </div>
  </div>
</section>