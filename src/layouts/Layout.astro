---
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portafolio de Arte de J. León C." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-crema text-negro font-serif selection:bg-oro selection:text-white">
		<slot />
	</body>
</html>

<style is:global>
	/* Definición de fuentes y colores globales si Tailwind falla */
	:root {
		--color-oro: #D4AF37;
		--color-crema: #F5F5DC;
		--color-negro: #1A1A1A;
	}
</style>